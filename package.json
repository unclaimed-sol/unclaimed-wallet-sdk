{
  "name": "@unclaimedsol/wallet-sdk",
  "version": "0.1.0-preview.1",
  "description": "Server-side TypeScript client for the Unclaimed API preview",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi/analysis.yaml",
    "README.md",
    "docs",
    "PRIOR_WORK.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run generate:check && npm run typecheck && npm run build && node --import tsx --test test/*.test.ts",
    "reference": "npm run build && node examples/reference/server.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "yaml": "2.8.2",
    "esbuild": "0.27.7"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unclaimed-sol/unclaimed-wallet-sdk.git"
  },
  "homepage": "https://github.com/unclaimed-sol/unclaimed-wallet-sdk#readme",
  "bugs": {
    "url": "https://github.com/unclaimed-sol/unclaimed-wallet-sdk/issues"
  }
}
